{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "svelte",
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*",
    "../src/core/**/*"
  ],
  "exclude": [
    "../src/core/**/*.test.ts"
  ]
}
