{
  "name": "sepia",
  "displayName": "sepia",
  "description": "Panel CAD from text files: schematics drawn from the panel's connections, ready for your own agent to edit.",
  "version": "0.0.1",
  "publisher": "joyauto",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyautomation/sepia.git",
    "directory": "tools/vscode-sepia"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "bin": {
    "sepia": "./out/cli.js"
  },
  "activationEvents": [
    "workspaceContains:**/sepia.json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "sepia.sheetEditor",
        "displayName": "sepia Sheet",
        "selector": [
          {
            "filenamePattern": "*.sheet.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "sepia.check",
        "title": "sepia: Check Project"
      },
      {
        "command": "sepia.view3d",
        "title": "sepia: Show Panel in 3D"
      },
      {
        "command": "sepia.print",
        "title": "sepia: Print Drawing Set to PDF"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p . && vite build && vite build --config vite.3d.config.mts",
    "watch": "vite build --watch",
    "test": "node --experimental-strip-types --test src/core/*.test.ts",
    "check": "svelte-check --tsconfig ./webview/tsconfig.json",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "test:e2e": "npm run build && xvfb-run -a node out/e2e/run.js",
    "test:gestures": "node --test gesture-harness/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  }
}
